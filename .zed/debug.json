[
  {
    "label": "Build & Debug Local",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "cargo",
      "args": ["build"],
      "env": {},
      "save": "all",
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/platformer",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "args": ["--no-music"],
    "env": {
      "RUST_LOG": "info",
    },
  },
]
